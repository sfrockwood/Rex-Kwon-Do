{
  "manifest_version": 3,
  "name": "Rex Kwon Do",
  "version": "1.0",
  "description": "Blocks websites after configurable time limits per session",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rex Kwon Do Settings"
  }
}